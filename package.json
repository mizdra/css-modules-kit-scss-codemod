{
  "name": "@css-modules-kit/scss-codemod",
  "version": "0.0.0",
  "description": "A collection of codemods for converting SCSS to CSS, for users of the CSS Modules Kit.",
  "homepage": "https://github.com/mizdra/css-modules-kit-scss-codemod#readme",
  "bugs": {
    "url": "https://github.com/mizdra/css-modules-kit-scss-codemod/issues"
  },
  "license": "MIT",
  "author": "mizdra <pp.mizdra@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizdra/css-modules-kit-scss-codemod.git"
  },
  "bin": {
    "scss-codemod": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  }
}
